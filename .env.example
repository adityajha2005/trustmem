# Copy to .env.local and fill in values (never commit .env.local).
# Load order: configs/default.yaml → .env → .env.local → shell env (highest).

# ---------------------------------------------------------------------------
# Retrieval mode
# ---------------------------------------------------------------------------
# 1 = deterministic hash embeddings (CI / fast ablations) — use for stable macOS benchmarks
# 0 = real sentence-transformers + FAISS semantic search (real-model runs; may abort on Py3.14/macOS)
MEMORY_OFFLINE_RETRIEVAL=0

# ---------------------------------------------------------------------------
# Models (MEMORY_ prefix)
# ---------------------------------------------------------------------------
MEMORY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MEMORY_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MEMORY_USE_RERANKER=true

# ---------------------------------------------------------------------------
# Trust-aware reranker fusion (see retrieval/rerank_fusion.py)
# ---------------------------------------------------------------------------
# MEMORY_RERANKER_WEIGHT=0.30
# MEMORY_FUSION_SEMANTIC_WEIGHT=0.30
# MEMORY_FUSION_TRUST_WEIGHT=0.30
# MEMORY_FUSION_IMPORTANCE_WEIGHT=0.10
# MEMORY_PRESERVE_TOP_TRUSTED_K=1
# MEMORY_TRUST_BUCKET_RERANKING=false
# MEMORY_TRUST_BUCKET_THRESHOLD=0.05
# MEMORY_TRUST_THRESHOLD=0.0

# ---------------------------------------------------------------------------
# Mem0 OSS (technique benchmark; optional OPENAI for infer=True only — we use infer=False)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=   # used by mem0 default LLM if you enable infer=True
# MEM0_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# xAI (E2E demo: python scripts/run_experiments.py demo)
# ---------------------------------------------------------------------------
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.7

# ---------------------------------------------------------------------------
# OpenAI-compatible second provider (real run: experiments/real_run.py --provider openai)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6-luna        # required, e.g. the GPT model you want the agents to run on

# ---------------------------------------------------------------------------
# Experiment paths
# ---------------------------------------------------------------------------
MEMORY_EXPERIMENTS_RUNS_DIR=./experiments/runs
MEMORY_LOG_LEVEL=INFO

# Experiment profile (fusion + reranker defaults): load configs/experiment.yaml
# MEMORY_EXPERIMENT_CONFIG=experiment
